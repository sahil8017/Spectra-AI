# ════════════════════════════════════════════════════════════
# Spectra AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env to version control.
# ════════════════════════════════════════════════════════════

# ─── Core ────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production

# ─── Authentication ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Google Gemini API ───────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here # Alias

# ─── Hugging Face API ────────────────────────────────────────
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# ─── Database ────────────────────────────────────────────────
# Local SQLite (default, no setup needed):
# POSTGRES_URL is optional — if not set, SQLite is used
#
# PostgreSQL / Neon (production):
# POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require
POSTGRES_URL=

# ─── Redis ───────────────────────────────────────────────────
# Local:      redis://localhost:6379/0
# Docker:     redis://redis:6379/0
# Upstash:    rediss://default:TOKEN@host:6379
REDIS_URL=redis://localhost:6379/0

# ─── AWS S3 (optional — local storage used if not set) ───────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────────
# These are applied at the application level via slowapi
# The per-plan token budgets are in services/cost_service.py
